---
import Logo from '@/components/Logo.astro'
import SocialSprite from '@/components/SocialSprite.astro'
import Field from '@/components/Field.astro'

const socialLinks = [
  { title: 'TikTok', href: '/', icon: 'icon-tiktok' },
  { title: 'YouTube', href: '/', icon: 'icon-youtube' },
  { title: 'Instagram', href: '/', icon: 'icon-instagram' },
  { title: 'Facebook', href: '/', icon: 'icon-facebook' },
  { title: 'Twitter', href: '/', icon: 'icon-twitter' },
]
---

<footer class="footer">
  <SocialSprite />
  <div class="footer-main">
    <div class="footer-main-inner container">
      <header class="footer-header">
        <Logo
          class="footer-logo"
          width={270}
          height={50}
          loading="lazy"
        />
        <p class="footer-description section-description">
          please feel free to send us an e-mail at
          <a href="mailto:kropp@qodeinteractive.com">kropp@qodeinteractive.com</a>
          For any additional inquiries
        </p>
      </header>
      <div class="footer-body">
        <div class="footer-column">
          <h2 class="footer-column-title">About</h2>
          <p class="footer-about">
            Shape up your site with Kropp, a theme especially made for fitness & gym websites.
          </p>
        </div>
        <div class="footer-column">
          <h2 class="footer-column-title">Working hours</h2>
          <div class="footer-schedule">
            Monday - Friday<br />
            <time datetime="05:30/24:00">05:30 - 24:00</time>
          </div>
          <div class="footer-schedule">
            Weekdays<br />
            <time datetime="00:00/24:00">00:00 - 24:00</time>
          </div>
        </div>
        <div class="footer-column">
          <h2 class="footer-column-title">Location</h2>
          <address class="footer-address">
            68 Jay Street, Brooklyn,<br />
            NY 11201, United States
          </address>
          <div class="footer-contacts">
            <ul class="footer-contacts-list">
              <li class="footer-contacts-item">
                <a
                  class="footer-contacts-link" href="mailto:kropp@qodeinteractive.com"
                >kropp@qodeinteractive.com
                </a>
              </li>
              <li class="footer-contacts-item">
                <a class="footer-contacts-link" href="tel:+17184076400">+ (1) 718 - 407 - 6400</a>
              </li>
            </ul>
          </div>
        </div>
        <div class="footer-column">
          <h2 class="footer-column-title has-arrow">start now</h2>
          <form class="footer-subscribe">
            <Field
              class="footer-subscribe-input"
              id="subscribe-email"
              label="Email"
              placeholder="Email"
              type="email"
            />
            <button
              class="footer-subscribe-button"
              type="submit"
              title="Subscribe"
            >
              <span class="visually-hidden">Subscribe</span>
            </button>
          </form>
          <div class="footer-soc1als">
            <ul class="footer-soc1als-list">
              {socialLinks.map(({ title, href, icon }) => (
                <li class="footer-soc1als-item">
                  <a
                    class="footer-soc1als-link" href={href} target="_blank" title={title}
                    aria-label={title}
                  >
                    <svg aria-hidden="true">
                      <use href={`#${icon}`} />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="footer-extra">
    <div class="footer-extra-inner container">
      <div class="footer-copyright">
        © <time datetime="2026">2026</time> Developed by&nbsp;
        <a
          href="https://github.com/verosabyrka"
          target="_blank" rel="noopener noreferrer"
        >
          Sabyrka
        </a>.
        All Rights Reserved | <a href="/">Privacy Policy</a> | <a href="/">Contact Us</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    --footerLogoWidth: 20.77%;
  }

  .footer-main {
    padding-top: 140px;
    padding-bottom: 160px;
    background-color: var(--color-dark);
  }

  .footer-header,
  .footer-body {
    display: grid;
    column-gap: 62px;
  }

  .footer-header {
    grid-template-columns: var(--footerLogoWidth) auto;

    &:not(:last-child) {
      margin-bottom: 60px;
    }
  }

  .footer-description {
    text-align: left;
  }

  .footer-body {
    grid-template-columns: var(--footerLogoWidth) repeat(3, 1fr);
  }

  .footer-column-title {
    font-size: clamp(18px, 1.15vw, 22px);

    &:not(:last-child) {
      margin-bottom: 15px;
    }

    &.has-arrow::after {
      content: '';
      display: inline-block;
      height: 0.74em;
      aspect-ratio: 1;
      margin-left: 0.5em;
      background: url('@/assets/icons/bold-arrow-down-right.svg') center / contain no-repeat;
      scale: -1 1;
    }
  }

  .footer-schedule {
    &:not(:last-child) {
      margin-bottom: 13px;
    }
  }

  .footer-address {
    font-style: normal;

    &:not(:last-child) {
      margin-bottom: 35px;
    }
  }

  .footer-subscribe {
    position: relative;

    &:not(:last-child) {
      margin-bottom: 50px;
    }
  }

  .footer-subscribe-input {
    padding-right: 70px;

    &:focus + .footer-subscribe-button {
      border-color: transparent;
      filter: invert(1);
    }
  }

  .footer-subscribe-button {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    aspect-ratio: 1;
    background: url('@/assets/icons/arrow-top-right.svg') center / 70% no-repeat;
    border: var(--border);
    border-radius: 50%;

    &:hover {
      rotate: 45deg;
    }

    &:active {
      scale: 0.97;
    }
  }

  .footer-soc1als-list {
    display: flex;
    column-gap: 18px;
  }

  .footer-soc1als-link {
    display: flex;
    width: 24px;
    height: 24px;
    color: var(--color-light);

    &:hover {
      color: var(--color-light-gray);
    }

    svg {
      width: 100%;
      height: 100%;
    }
  }

  .footer-extra {
    padding-block: 15px;
  }

  .footer-copyright {
    font-size: 14px;
  }

  @media (max-width: 1024px) {
    .footer-main {
      padding-top: 80px;
      padding-bottom: 50px;
    }

    .footer-header {
      display: flex;
      flex-direction: column;
      row-gap: 30px;
    }

    .footer-body {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 30px;
    }
  }

  @media (max-width: 767px) {
    .footer-body {
      grid-template-columns: 1fr;
    }

    .footer-main {
      padding-top: 50px;
    }

    .footer-header:not(:last-child) {
      margin-bottom: 30px;
    }

    .footer-subscribe:not(:last-child) {
      margin-bottom: 40px;
    }
  }
</style>
