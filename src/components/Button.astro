---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'button'> {
  class?: string
  type?: 'button' | 'submit' | 'reset'
  isTransparent?: boolean
}

const {
  class: className,
  type = 'button',
  isTransparent = false,
  ...rest
} = Astro.props
---

<button
  class:list={[
    'button',
    {
      transparent: isTransparent,
    },
    className,
  ]}
  type={type}
  {...rest}
>
  <slot />
</button>
