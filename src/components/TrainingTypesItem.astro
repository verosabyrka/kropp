---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'li'> {
  title: string
  image: ImageMetadata
}

const { title, image, ...rest } = Astro.props
---

<li class="training-types-item" {...rest}>
  <Image
    class="training-types-image"
    src={image}
    alt=""
    width={150}
    height={140}
  />
  <h3 class="training-types-item-title">{title}</h3>
</li>
