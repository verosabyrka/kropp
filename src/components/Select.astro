---
import type { HTMLAttributes } from 'astro/types'

interface Option {
  value: string
  title: string
}

interface Props extends HTMLAttributes<'select'> {
  id: string
  label: string
  class?: string
  placeholder?: string
  options?: Option[]
}

const {
  id,
  label,
  class: className,
  placeholder = 'Select an option',
  options = [],
  required,
  value: selectedValue = '',
  name,
  ...rest
} = Astro.props

const initialSelectedOption = options.find((opt) => opt.value === selectedValue)
const initialText = initialSelectedOption ? initialSelectedOption.title : placeholder
const isInitialPlaceholder = !initialSelectedOption
---

<div class:list={['select', className]} data-js-select>
  <label class="visually-hidden" for={id}>
    {label}
  </label>

  <select
    class="visually-hidden"
    id={id}
    name={name}
    required={required}
    tabindex="-1"
    aria-hidden="true"
    data-js-select-native
    {...rest}
  >
    {placeholder && (
      <option value="" disabled selected={isInitialPlaceholder}>
        {placeholder}
      </option>
    )}
    {options.map(({ value, title }) => (
      <option value={value} selected={value === selectedValue}>
        {title}
      </option>
    ))}
  </select>

  <button
    type="button"
    class:list={['select-button', 'input', { 'is-placeholder': isInitialPlaceholder }]}
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-labelledby={id}
    data-js-select-button
  >
    <span class="select-button-text" data-js-select-text>
      {initialText}
    </span>
    <span class="select-button-icon" aria-hidden="true">
      <svg viewBox="0 0 10 6" width="10" height="6" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </button>

  <div class="select-dropdown" data-js-select-dropdown>
    <ul class="select-list" role="listbox" aria-label={label} data-js-select-list>
      {options.map(({ value, title }) => (
        <li
          class:list={['select-option', { 'is-selected': value === selectedValue }]}
          role="option"
          aria-selected={value === selectedValue ? 'true' : 'false'}
          data-value={value}
          data-js-select-option
          tabindex="-1"
        >
          <span class="select-option-text">{title}</span>
          <span class="select-option-check" aria-hidden="true">
            <svg viewBox="0 0 12 10" width="12" height="10" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 5L4.5 8.5L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  @keyframes selectDropdownFadeIn {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .select {
    position: relative;
    width: 100%;
    user-select: none;

    &.is-open {
      .select-button {
        border-color: var(--color-light);
      }

      .select-button-icon {
        transform: rotate(180deg);
      }

      .select-dropdown {
        display: block;
        animation: selectDropdownFadeIn var(--transition-duration) cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }
    }
  }

  .select-button {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: var(--input-height);
    padding-inline: 25px;
    font-family: inherit;
    font-size: 16px;
    text-align: left;
    color: var(--color-light);
    background-color: transparent;
    border: 1px solid var(--color-light-gray);
    border-radius: var(--border-radius);
    cursor: pointer;
    transition-duration: var(--transition-duration);

    &.is-placeholder {
      color: var(--color-light-gray);
    }

    &:hover {
      border-color: var(--color-light);
    }

    &:focus-visible {
      border-color: var(--color-light);
      outline: 2px dashed var(--color-light);
      outline-offset: 4px;
    }
  }

  .select-button-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .select-button-icon {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    margin-left: 12px;
    color: currentColor;
    transition-duration: var(--transition-duration);

    svg {
      width: 100%;
      height: 100%;
    }
  }

  .select-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 50;
    width: 100%;
    max-height: 240px;
    overflow-y: auto;
    padding: 8px;
    background-color: var(--color-dark-alt);
    border: 1px solid var(--color-dark-gray);
    border-radius: var(--border-radius-sm);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.7);
    scrollbar-width: thin;
    scrollbar-color: var(--color-dark-gray) transparent;
  }

  .select-list {
    display: flex;
    flex-direction: column;
    row-gap: 4px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .select-option {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    font-size: 15px;
    line-height: 1.3;
    color: var(--color-light-gray);
    background-color: transparent;
    border-radius: calc(var(--border-radius-sm) - 6px);
    cursor: pointer;
    transition-duration: var(--transition-duration);

    &:hover,
    &:focus-visible {
      color: var(--color-light);
      background-color: var(--color-dark-gray);
      outline: none;
    }

    &.is-selected {
      color: var(--color-light);
      background-color: rgb(255 255 255 / 0.08);

      .select-option-check {
        opacity: 1;
        transform: scale(1);
      }
    }
  }

  .select-option-text {
    flex-grow: 1;
  }

  .select-option-check {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    margin-left: 10px;
    color: var(--color-light);
    opacity: 0;
    transform: scale(0.6);
    transition-duration: var(--transition-duration);

    svg {
      width: 100%;
      height: 100%;
    }
  }
</style>
