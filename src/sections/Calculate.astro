---
import Button from '@/components/Button.astro'
import Field from '@/components/Field.astro'
import Select from '@/components/Select.astro'

const genderOptions = [
  { value: 'male', title: 'Male' },
  { value: 'female', title: 'Female' },
]

const activityFactorOptions = [
  { value: '1.2', title: '1.2 — Sedentary (little or no exercise)' },
  { value: '1.375', title: '1.375 — Lightly active (light exercise 1–3 days/week)' },
  { value: '1.55', title: '1.55 — Moderately active (moderate exercise 3–5 days/week)' },
  { value: '1.725', title: '1.725 — Very active (hard exercise 6–7 days/week)' },
  { value: '1.9', title: '1.9 — Extra active (very hard exercise & physical job)' },
]
---

<section class="calculate">
  <div class="calculate-inner container">
    <div class="calculate-body">
      <h2
        class="calculate-title title-medium backdrop-title"
        data-title="BMI"
      >
        Input your BMI
      </h2>
      <div class="calculate-description">
        <p>Duo graece ponderum ne, ei mel aliquando. Pro te tamquam nonumes, nam no nemore epicurei</p>
      </div>
      <form class="calculate-form">
        <div class="calculate-form-body">
          <Field
            class="calculate-input"
            id="height"
            label="Height"
            type="number"
            placeholder="Height / cm"
          />

          <Field
            class="calculate-input"
            id="weight"
            label="Weight"
            type="number"
            placeholder="Weight / kg"
          />

          <Field
            class="calculate-input"
            id="age"
            label="Age"
            type="number"
            placeholder="Age"
          />

          <Select
            class="calculate-input"
            id="gender"
            label="Gender"
            aria-label="Gender"
            placeholder="Gender"
            options={genderOptions}
            required
          />

          <Select
            class="calculate-input wide"
            id="activity-factor"
            label="Activity factor"
            aria-label="Activity factor"
            placeholder="Select an activity factor"
            options={activityFactorOptions}
            required
          />
        </div>
        <Button
          class="calculate-button"
          type="submit"
          isTransparent
        >
          Calculate
        </Button>
      </form>
    </div>
    <div class="calculate-table-wrapper">
      <table class="calculate-table">
        <thead>
          <tr>
            <th>BMI</th>
            <th>Weight status</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Below 18.5</td>
            <td>Underweight</td>
          </tr>
          <tr>
            <td>18.5 - 24.9</td>
            <td>Healthy</td>
          </tr>
          <tr>
            <td>25.0 - 29.9</td>
            <td>Overweight</td>
          </tr>
          <tr>
            <td>30.0 - and Above</td>
            <td>Obese</td>
          </tr>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="2">
              <span class="font-bold">BMR</span> Metabolic Rate /
              <span class="font-bold">BMI</span> Body Mass Index</td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</section>
