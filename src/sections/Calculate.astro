---
import Button from '@/components/Button.astro'
import Field from '@/components/Field.astro'
import Select from '@/components/Select.astro'

const genderOptions = [
  { value: 'male', title: 'Male' },
  { value: 'female', title: 'Female' },
]

const activityFactorOptions = [
  { value: '1.2', title: '1.2 — Sedentary (little or no exercise)' },
  { value: '1.375', title: '1.375 — Lightly active (light exercise 1–3 days/week)' },
  { value: '1.55', title: '1.55 — Moderately active (moderate exercise 3–5 days/week)' },
  { value: '1.725', title: '1.725 — Very active (hard exercise 6–7 days/week)' },
  { value: '1.9', title: '1.9 — Extra active (very hard exercise & physical job)' },
]
---

<section class="calculate">
  <div class="calculate-inner container">
    <div class="calculate-body">
      <h2
        class="calculate-title title-medium backdrop-title"
        data-title="BMI"
      >
        Input your BMI
      </h2>
      <div class="calculate-description">
        <p>Duo graece ponderum ne, ei mel aliquando. Pro te tamquam nonumes, nam no nemore epicurei</p>
      </div>
      <form class="calculate-form">
        <div class="calculate-form-body">
          <Field
            class="calculate-input"
            id="height"
            label="Height"
            type="number"
            placeholder="Height / cm"
          />

          <Field
            class="calculate-input"
            id="weight"
            label="Weight"
            type="number"
            placeholder="Weight / kg"
          />

          <Field
            class="calculate-input"
            id="age"
            label="Age"
            type="number"
            placeholder="Age"
          />

          <Select
            class="calculate-input"
            id="gender"
            label="Gender"
            aria-label="Gender"
            placeholder="Gender"
            options={genderOptions}
            required
          />

          <Select
            class="calculate-input wide"
            id="activity-factor"
            label="Activity factor"
            aria-label="Activity factor"
            placeholder="Select an activity factor"
            options={activityFactorOptions}
            required
          />
        </div>
        <Button
          class="calculate-button"
          type="submit"
          isTransparent
        >
          Calculate
        </Button>
      </form>
    </div>
    <div class="calculate-table-wrapper">
      <table class="calculate-table">
        <thead>
          <tr>
            <th>BMI</th>
            <th>Weight status</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Below 18.5</td>
            <td>Underweight</td>
          </tr>
          <tr>
            <td>18.5 - 24.9</td>
            <td>Healthy</td>
          </tr>
          <tr>
            <td>25.0 - 29.9</td>
            <td>Overweight</td>
          </tr>
          <tr>
            <td>30.0 - and Above</td>
            <td>Obese</td>
          </tr>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="2">
              <span class="font-bold">BMR</span> Metabolic Rate /
              <span class="font-bold">BMI</span> Body Mass Index
            </td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</section>

<style>
  .calculate {
    padding-block: 146px;
  }

  .calculate-inner {
    display: flex;
    align-items: center;
    column-gap: 36px;
  }

  .calculate-body {
    flex-grow: 1;
    max-width: 627px;
  }

  .calculate-title {
    &:not(:last-child) {
      margin-bottom: 16px;
    }
  }

  .calculate-description {
    max-width: 385px;

    &:not(:last-child) {
      margin-bottom: 30px;
    }
  }

  .calculate-form-body {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px 30px;

    &:not(:last-child) {
      margin-bottom: 26px;
    }
  }

  .calculate-input {
    &.wide {
      grid-column: -1 / 1;
    }
  }

  .calculate-table-wrapper {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 610px;

    &::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      translate: -50% -50%;
      width: 100%;
      aspect-ratio: 1;
      background-color: var(--color-dark);
      border-radius: 50%;
    }
  }

  .calculate-table {
    position: relative;
    border-collapse: collapse;

    :is(td, th) {
      padding-right: 30px;

      &:not(:first-child) {
        padding-left: 30px;
      }

      &:not(:last-child) {
        border-right: 1px solid var(--color-dark-gray-alt);
      }
    }

    th {
      padding-block: 20px;
      text-align: left;
      text-transform: uppercase;
      color: var(--color-light);
    }

    td {
      padding-block: 14px;
    }

    tbody {
      td {
        border-top: 1px solid var(--color-dark-gray-alt);
      }

      tr:last-child td:first-child {
        position: relative;

        &::after {
          content: '';
          position: absolute;
          bottom: 0;
          right: 0;
          width: 70%;
          height: 1px;
          background-color: var(--color-dark-gray-alt);
        }
      }
    }

    tfoot {
      color: var(--color-light);

      td {
        padding-top: 33px;
        padding-bottom: 0;
      }
    }
  }

  @media (max-width: 1024px) {
    .calculate {
      padding-block: 100px;
    }

    .calculate-inner {
      column-gap: 20px;
    }

    .calculate-form-body {
      grid-template-columns: 1fr;
    }

    .calculate-button {
      width: 100%;
    }

    .calculate-table {
      & :is(td, th) {
        padding-block: 10px;
      }
    }

    & tfoot td {
      padding-top: 10px;
    }
  }

  @media (max-width: 767px) {
    .calculate {
      padding-block: 60px;
    }

    .calculate-inner {
      flex-direction: column;
      row-gap: 30px;
    }

    .calculate-table-wrapper::before {
      display: none;
    }
  }
</style>
