---
import Button from '@/components/Button.astro'
import Field from '@/components/Field.astro'
import Select from '@/components/Select.astro'

const genderOptions = [
  { value: 'male', title: 'Male' },
  { value: 'female', title: 'Female' },
]

const activityFactorOptions = [
  { value: '1.2', title: '1.2 — Sedentary (little or no exercise)' },
  { value: '1.375', title: '1.375 — Lightly active (light exercise 1–3 days/week)' },
  { value: '1.55', title: '1.55 — Moderately active (moderate exercise 3–5 days/week)' },
  { value: '1.725', title: '1.725 — Very active (hard exercise 6–7 days/week)' },
  { value: '1.9', title: '1.9 — Extra active (very hard exercise & physical job)' },
]
---

<section class="calculate">
  <div class="calculate-inner container">
    <div class="calculate-body">
      <h2
        class="calculate-title title-medium backdrop-title"
        data-title="BMI"
      >
        Input your BMI
      </h2>
      <div class="calculate-description">
        <p>Duo graece ponderum ne, ei mel aliquando. Pro te tamquam nonumes, nam no nemore epicurei</p>
      </div>
      <form class="calculate-form" data-js-calculate-form>
        <div class="calculate-form-body">
          <Field
            class="calculate-input"
            id="height"
            name="height"
            label="Height"
            type="number"
            min="50"
            max="250"
            step="1"
            placeholder="Height / cm"
            required
          />

          <Field
            class="calculate-input"
            id="weight"
            name="weight"
            label="Weight"
            type="number"
            min="20"
            max="300"
            step="0.1"
            placeholder="Weight / kg"
            required
          />

          <Field
            class="calculate-input"
            id="age"
            name="age"
            label="Age"
            type="number"
            min="10"
            max="120"
            step="1"
            placeholder="Age"
            required
          />

          <Select
            class="calculate-input"
            id="gender"
            name="gender"
            label="Gender"
            aria-label="Gender"
            placeholder="Gender"
            options={genderOptions}
            required
          />

          <Select
            class="calculate-input wide"
            id="activity-factor"
            name="activityFactor"
            label="Activity factor"
            aria-label="Activity factor"
            placeholder="Select an activity factor"
            options={activityFactorOptions}
            required
          />
        </div>
        <Button
          class="calculate-button"
          type="submit"
          isTransparent
        >
          Calculate
        </Button>
      </form>
    </div>
    <div class="calculate-table-wrapper">
      <table class="calculate-table">
        <thead>
          <tr>
            <th>BMI</th>
            <th>Weight status</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Below 18.5</td>
            <td>Underweight</td>
          </tr>
          <tr>
            <td>18.5 - 24.9</td>
            <td>Healthy</td>
          </tr>
          <tr>
            <td>25.0 - 29.9</td>
            <td>Overweight</td>
          </tr>
          <tr>
            <td>30.0 - and Above</td>
            <td>Obese</td>
          </tr>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="2">
              <span class="font-bold">BMR</span> Metabolic Rate /
              <span class="font-bold">BMI</span> Body Mass Index
            </td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>

  <dialog class="calculate-modal" data-js-calculate-modal aria-labelledby="modal-title">
    <div class="calculate-modal-card">
      <header class="calculate-modal-header">
        <h3 class="calculate-modal-title title-medium" id="modal-title">Your Results</h3>
        <button
          type="button"
          class="calculate-modal-close-btn"
          data-js-calculate-modal-close
          aria-label="Close modal"
          title="Close"
        >
          <span aria-hidden="true">&times;</span>
        </button>
      </header>

      <div class="calculate-modal-content">
        <div class="calculate-results-grid">
          <div class="calculate-result-item">
            <span class="calculate-result-label">BMI (Body Mass Index)</span>
            <div class="calculate-result-value" data-js-calculate-result-bmi>—</div>
            <span class="calculate-result-badge" data-js-calculate-result-status>Healthy</span>
          </div>

          <div class="calculate-result-item">
            <span class="calculate-result-label">BMR (Basal Metabolic Rate)</span>
            <div class="calculate-result-value">
              <span data-js-calculate-result-bmr>—</span> <small>kcal/day</small>
            </div>
            <span class="calculate-result-hint">Base calories burned at complete rest</span>
          </div>
        </div>

        <div class="calculate-calories-block">
          <h4 class="calculate-calories-heading">Daily Calorie Needs (TDEE)</h4>
          <ul class="calculate-calories-list">
            <li class="calculate-calories-item">
              <span class="calorie-type">Maintain weight</span>
              <span class="calorie-val font-bold"><span
                data-js-calculate-result-maintain
              >—</span> kcal</span>
            </li>
            <li class="calculate-calories-item">
              <span class="calorie-type">Mild weight loss (-0.25 kg/week)</span>
              <span class="calorie-val font-bold"><span data-js-calculate-result-loss>—</span> kcal</span>
            </li>
            <li class="calculate-calories-item">
              <span class="calorie-type">Weight gain (+0.25 kg/week)</span>
              <span class="calorie-val font-bold"><span data-js-calculate-result-gain>—</span> kcal</span>
            </li>
          </ul>
        </div>
      </div>

      <footer class="calculate-modal-footer">
        <Button class="calculate-modal-btn" data-js-calculate-modal-ok type="button">
          Got it
        </Button>
      </footer>
    </div>
  </dialog>
</section>

<style>
  @keyframes modalFadeIn {
    from {
      opacity: 0;
      transform: scale(0.95) translateY(10px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @keyframes modalFadeOut {
    from {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
    to {
      opacity: 0;
      transform: scale(0.95) translateY(10px);
    }
  }

  @keyframes backdropFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes backdropFadeOut {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  .calculate {
    padding-block: 146px;
  }

  .calculate-inner {
    display: flex;
    align-items: center;
    column-gap: 36px;
  }

  .calculate-body {
    flex-grow: 1;
    max-width: 627px;
  }

  .calculate-title {
    &:not(:last-child) {
      margin-bottom: 16px;
    }
  }

  .calculate-description {
    max-width: 385px;

    &:not(:last-child) {
      margin-bottom: 30px;
    }
  }

  .calculate-form-body {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px 30px;

    &:not(:last-child) {
      margin-bottom: 26px;
    }

    :global(.calculate-input.wide) {
      grid-column: -1 / 1;
    }
  }

  .calculate-table-wrapper {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 610px;

    &::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      translate: -50% -50%;
      width: 100%;
      aspect-ratio: 1;
      background-color: var(--color-dark);
      border-radius: 50%;
    }
  }

  .calculate-table {
    position: relative;
    border-collapse: collapse;

    :is(td, th) {
      padding-right: 30px;

      &:not(:first-child) {
        padding-left: 30px;
      }

      &:not(:last-child) {
        border-right: 1px solid var(--color-dark-gray-alt);
      }
    }

    th {
      padding-block: 20px;
      text-align: left;
      text-transform: uppercase;
      color: var(--color-light);
    }

    td {
      padding-block: 14px;
    }

    tbody {
      td {
        border-top: 1px solid var(--color-dark-gray-alt);
      }

      tr:last-child td:first-child {
        position: relative;

        &::after {
          content: '';
          position: absolute;
          bottom: 0;
          right: 0;
          width: 70%;
          height: 1px;
          background-color: var(--color-dark-gray-alt);
        }
      }
    }

    tfoot {
      color: var(--color-light);

      td {
        padding-top: 33px;
        padding-bottom: 0;
      }
    }
  }

  .calculate-modal {
    width: 100%;
    max-width: min(520px, calc(100vw - 32px));
    margin: auto;
    padding: 0;
    background: transparent;
    border: none;

    &::backdrop {
      background: rgb(0 0 0 / 0.75);
      backdrop-filter: blur(4px);
    }

    &[open] {
      animation: modalFadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;

      &::backdrop {
        animation: backdropFadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }
    }

    &.is-closing {
      animation: modalFadeOut 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;

      &::backdrop {
        animation: backdropFadeOut 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }
    }
  }

  .calculate-modal-card {
    display: flex;
    flex-direction: column;
    row-gap: 24px;
    padding: 36px 32px;
    color: var(--color-light-gray);
    background-color: var(--color-dark-alt);
    border: 1px solid var(--color-dark-gray);
    border-radius: var(--border-radius);
  }

  .calculate-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .calculate-modal-title {
    font-size: 28px;
    text-transform: uppercase;
    color: var(--color-light);
  }

  .calculate-modal-close-btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 36px;
    height: 36px;
    font-size: 24px;
    line-height: 1;
    color: var(--color-light);
    background: transparent;
    border: 1px solid var(--color-dark-gray);
    border-radius: 50%;
    cursor: pointer;
    transition: all var(--transition-duration) ease;

    &:hover {
      color: var(--color-light);
      background-color: var(--color-dark-gray);
      border-color: var(--color-light);
    }

    &:active {
      scale: 0.97;
    }
  }

  .calculate-modal-content {
    display: flex;
    flex-direction: column;
    row-gap: 24px;
  }

  .calculate-results-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .calculate-result-item,
  .calculate-calories-block {
    background-color: var(--color-dark);
    border: 1px solid var(--color-dark-gray);
    border-radius: var(--border-radius-sm);
  }

  .calculate-result-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    row-gap: 8px;
    padding: 18px 16px;
    text-align: center;
  }

  .calculate-result-label {
    font-size: 13px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-light-gray);
  }

  .calculate-result-value {
    font-family: var(--font-family-accent);
    font-size: 32px;
    font-weight: 700;
    color: var(--color-light);

    small {
      font-size: 14px;
      font-weight: 400;
      color: var(--color-light-gray);
    }
  }

  .calculate-result-badge {
    display: inline-block;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-radius: var(--border-radius-sm);

    &.status-healthy {
      color: #4ade80;
      background-color: rgb(34 197 94 / 0.2);
      border: 1px solid rgb(74 222 128 / 0.4);
    }

    &.status-underweight {
      color: #60a5fa;
      background-color: rgb(59 130 246 / 0.2);
      border: 1px solid rgb(96 165 250 / 0.4);
    }

    &.status-overweight {
      color: #facc15;
      background-color: rgb(234 179 8 / 0.2);
      border: 1px solid rgb(250 204 21 / 0.4);
    }

    &.status-obese {
      color: #f87171;
      background-color: rgb(239 68 68 / 0.2);
      border: 1px solid rgb(248 113 113 / 0.4);
    }
  }

  .calculate-result-hint {
    font-size: 12px;
    line-height: 1.3;
    color: var(--color-dark-gray-alt);
  }

  .calculate-calories-block {
    display: flex;
    flex-direction: column;
    row-gap: 12px;
    padding: 18px 20px;
  }

  .calculate-calories-heading {
    padding-bottom: 8px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-light);
  }

  .calculate-calories-list {
    display: flex;
    flex-direction: column;
    row-gap: 10px;
  }

  .calculate-calories-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;

    .calorie-type {
      color: var(--color-light-gray);
    }

    .calorie-val {
      font-family: var(--font-family-accent);
      font-size: 15px;
      color: var(--color-light);
    }
  }

  .calculate-modal-footer {
    display: flex;
    justify-content: center;
  }

  .calculate-modal-btn {
    display: inline-flex;
    justify-content: center;
    min-width: 160px;
    text-align: center;
  }

  @media (max-width: 1024px) {
    .calculate {
      padding-block: 100px;
    }

    .calculate-inner {
      column-gap: 20px;
    }

    .calculate-form-body {
      grid-template-columns: 1fr;
    }

    .calculate-button {
      width: 100%;
    }

    .calculate-table {
      & :is(td, th) {
        padding-block: 10px;
      }

      & tfoot td {
        padding-top: 10px;
      }
    }
  }

  @media (max-width: 767px) {
    .calculate {
      padding-block: 60px;
    }

    .calculate-inner {
      flex-direction: column;
      row-gap: 30px;
    }

    .calculate-table-wrapper::before {
      display: none;
    }
  }

  @media (max-width: 576px) {
    .calculate-modal-card {
      row-gap: 18px;
      padding: 24px 16px;
    }

    .calculate-modal-title {
      font-size: 22px;
    }

    .calculate-modal-close-btn {
      width: 32px;
      height: 32px;
      font-size: 20px;
    }

    .calculate-modal-content {
      row-gap: 16px;
    }

    .calculate-result-item {
      padding: 14px 12px;
    }

    .calculate-result-value {
      font-size: 26px;
    }

    .calculate-calories-block {
      row-gap: 10px;
      padding: 14px 16px;
    }
  }

  @media (max-width: 480px) {
    .calculate-results-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .calculate-calories-item {
      flex-direction: column;
      align-items: flex-start;
      row-gap: 4px;
      font-size: 13px;
    }

    .calculate-modal-btn {
      width: 100%;
    }
  }
</style>

<script>
  import { calculateFitnessMetrics } from '@/utils/calculator'

  class BMICalculator {
    selectors = {
      form: '[data-js-calculate-form]',
      modal: '[data-js-calculate-modal]',
      closeButton: '[data-js-calculate-modal-close]',
      okButton: '[data-js-calculate-modal-ok]',
      resultBmi: '[data-js-calculate-result-bmi]',
      resultBmiStatus: '[data-js-calculate-result-status]',
      resultBmr: '[data-js-calculate-result-bmr]',
      resultMaintain: '[data-js-calculate-result-maintain]',
      resultLoss: '[data-js-calculate-result-loss]',
      resultGain: '[data-js-calculate-result-gain]',
    }

    stateClasses = {
      isLock: 'is-lock',
      isClosing: 'is-closing',
      healthy: 'status-healthy',
      underweight: 'status-underweight',
      overweight: 'status-overweight',
      obese: 'status-obese',
    }

    formElement: HTMLFormElement | null
    modalElement: HTMLDialogElement | null
    closeButtonElement: HTMLButtonElement | null
    okButtonElement: HTMLButtonElement | null
    resultBmiElement: HTMLElement | null
    resultBmiStatusElement: HTMLElement | null
    resultBmrElement: HTMLElement | null
    resultMaintainElement: HTMLElement | null
    resultLossElement: HTMLElement | null
    resultGainElement: HTMLElement | null

    constructor() {
      this.formElement = document.querySelector(this.selectors.form)
      this.modalElement = document.querySelector(this.selectors.modal)
      this.closeButtonElement = document.querySelector(this.selectors.closeButton)
      this.okButtonElement = document.querySelector(this.selectors.okButton)

      this.resultBmiElement = document.querySelector(this.selectors.resultBmi)
      this.resultBmiStatusElement = document.querySelector(this.selectors.resultBmiStatus)
      this.resultBmrElement = document.querySelector(this.selectors.resultBmr)
      this.resultMaintainElement = document.querySelector(this.selectors.resultMaintain)
      this.resultLossElement = document.querySelector(this.selectors.resultLoss)
      this.resultGainElement = document.querySelector(this.selectors.resultGain)

      this.bindEvents()
    }

    updateResults() {
      if (!this.formElement) return false

      const formData = new FormData(this.formElement)
      const res = calculateFitnessMetrics({
        height: parseFloat(formData.get('height') as string),
        weight: parseFloat(formData.get('weight') as string),
        age: parseFloat(formData.get('age') as string),
        gender: formData.get('gender') as string,
        activityFactor: parseFloat(formData.get('activityFactor') as string),
      })

      if (!res) return false

      if (this.resultBmiElement) this.resultBmiElement.textContent = res.bmi.toString()
      if (this.resultBmrElement) this.resultBmrElement.textContent = res.bmr.toLocaleString()
      if (this.resultMaintainElement) this.resultMaintainElement.textContent = res.tdeeMaintain.toLocaleString()
      if (this.resultLossElement) this.resultLossElement.textContent = res.tdeeLoss.toLocaleString()
      if (this.resultGainElement) this.resultGainElement.textContent = res.tdeeGain.toLocaleString()

      if (this.resultBmiStatusElement) {
        const modifier = this.stateClasses[res.category.key]
        this.resultBmiStatusElement.textContent = res.category.label
        this.resultBmiStatusElement.className = `calculate-result-badge ${modifier}`
      }

      return true
    }

    openModal() {
      if (!this.modalElement) return
      this.modalElement.classList.remove(this.stateClasses.isClosing)
      this.modalElement.showModal()
      document.body.classList.add(this.stateClasses.isLock)
    }

    closeModal() {
      if (
        !this.modalElement ||
        !this.modalElement.open ||
        this.modalElement.classList.contains(this.stateClasses.isClosing)
      ) {
        return
      }

      this.modalElement.classList.add(this.stateClasses.isClosing)

      const onAnimationEnd = () => {
        if (!this.modalElement) return
        this.modalElement.classList.remove(this.stateClasses.isClosing)
        this.modalElement.close()
        document.body.classList.remove(this.stateClasses.isLock)
      }

      this.modalElement.addEventListener('animationend', onAnimationEnd, { once: true })
    }

    onFormInput = () => {
      this.updateResults()
    }

    onFormSubmit = (e: SubmitEvent) => {
      e.preventDefault()
      const isSuccess = this.updateResults()
      if (isSuccess) {
        this.openModal()
      } else {
        this.formElement?.reportValidity()
      }
    }

    onModalClick = (e: MouseEvent) => {
      if (e.target === this.modalElement) {
        this.closeModal()
      }
    }

    onModalCancel = (e: Event) => {
      e.preventDefault()
      this.closeModal()
    }

    onModalClose = () => {
      this.modalElement?.classList.remove(this.stateClasses.isClosing)
      document.body.classList.remove(this.stateClasses.isLock)
    }

    bindEvents() {
      this.formElement?.addEventListener('input', this.onFormInput)
      this.formElement?.addEventListener('submit', this.onFormSubmit)
      this.closeButtonElement?.addEventListener('click', () => this.closeModal())
      this.okButtonElement?.addEventListener('click', () => this.closeModal())
      this.modalElement?.addEventListener('click', this.onModalClick)
      this.modalElement?.addEventListener('cancel', this.onModalCancel)
      this.modalElement?.addEventListener('close', this.onModalClose)
    }
  }

  new BMICalculator()
</script>
