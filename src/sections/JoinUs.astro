---
import posterImage from '@/assets/images/join-us/video-placeholder.jpg'
import Button from '@/components/Button.astro'
import Field from '@/components/Field.astro'
---

<section class="join-us">
  <div class="join-us-video-wrapper" data-js-video-wrapper>
    <video
      class="join-us-video"
      src=""
      width="960"
      height="600"
      poster={posterImage.src}
      data-js-video
    ></video>
    <button
      class="join-us-video-play-button"
      type="button"
      data-js-video-play-button
    >
      Play
    </button>
  </div>
  <div class="join-us-body container">
    <h2 class="join-us-title">Join us</h2>
    <form class="join-us-form">
      <header class="join-us-form-header">
        <h3
          class="join-us-form-title backdrop-title centered title-big"
          data-title="Go!"
        >
          Start here
        </h3>
        <div class="join-us-form-subtitle section-description">
          fill the form below to start your journey
        </div>
      </header>
      <div class="join-us-form-body">
        <Field
          class="join-us-form-input"
          id="username"
          label="Name"
          placeholder="Name"
        />
        <Field
          class="join-us-form-input"
          id="email"
          label="Email"
          placeholder="Email"
          type="email"
        />
        <Button
          class="join-us-form-button"
          type="submit"
          isTransparent
        >
          Subscribe
        </Button>
      </div>
    </form>
  </div>
</section>

<style>
  .join-us-video-wrapper {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 150px 30px;
    background: url('@/assets/images/join-us/join-us-bg.jpg') center / cover no-repeat;
  }

  .join-us-video {
    width: 100%;
    max-width: 960px;
    height: auto;
  }

  .join-us-video-play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    column-gap: 4px;
    width: 200px;
    aspect-ratio: 1;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-light);
    background-color: transparent;
    border: var(--border);
    border-radius: 50%;
    will-change: transform;

    &::after {
      content: '';
      width: 26px;
      aspect-ratio: 1;
      background: url('@/assets/icons/arrow-top-right.svg') center / contain no-repeat;
      transition-duration: var(--transition-duration);
    }

    &:hover {
      color: var(--color-dark);
      background-color: var(--color-light);

      &::after {
        filter: invert(1);
      }
    }

    &:active {
      scale: 0.97;
    }
  }

  .join-us-body {
    padding-bottom: 150px;
  }

  .join-us-title {
    position: relative;
    margin-top: -0.4em;
    font-size: clamp(64px, 9.37vw, 180px);
    line-height: 1;
    text-align: center;

    &::after {
      content: '';
      display: inline-block;
      height: 0.7em;
      aspect-ratio: 1;
      margin-left: 0.14em;
      background: url('@/assets/icons/bold-arrow-down-right.svg') center / contain no-repeat;
      scale: 1 -1;
    }

    &:not(:last-child) {
      margin-bottom: 130px;
    }
  }

  .join-us-form-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    row-gap: 7px;

    &:not(:last-child) {
      margin-bottom: 52px;
    }
  }

  .join-us-form-body {
    display: flex;
    justify-content: center;
    column-gap: 20px;
  }

  .join-us-form-input {
    max-width: 400px;
  }

  @media (max-width: 1024px) {
    .join-us-body {
      padding-bottom: 80px;
    }

    .join-us-title:not(:last-child) {
      margin-bottom: 70px;
    }
  }

  @media (max-width: 767px) {
    .join-us-video-wrapper {
      padding-block: 70px;
    }

    .join-us-video-play-button {
      width: 140px;
    }

    .join-us-title:not(:last-child) {
      margin-bottom: 40px;
    }

    .join-us-form-body {
      flex-direction: column;
      align-items: center;
      row-gap: 20px;
    }
  }
</style>

<script>
  class FloatingPlayButton {
    selectors = {
      wrapper: '[data-js-video-wrapper]',
      video: '[data-js-video]',
      button: '[data-js-video-play-button]',
    }

    wrapperElement: HTMLElement | null
    videoElement: HTMLElement | null
    buttonElement: HTMLElement | null

    targetX = 0
    targetY = 0
    currentX = 0
    currentY = 0
    rafId: number | null = null
    isHovered = false

    constructor() {
      this.wrapperElement = document.querySelector(this.selectors.wrapper)
      this.videoElement = document.querySelector(this.selectors.video)
      this.buttonElement = document.querySelector(this.selectors.button)

      this.bindEvents()
    }

    onMouseMove = (e: MouseEvent) => {
      if (!this.videoElement || !this.buttonElement) return

      const videoRect = this.videoElement.getBoundingClientRect()
      const isInside =
        e.clientX >= videoRect.left &&
        e.clientX <= videoRect.right &&
        e.clientY >= videoRect.top &&
        e.clientY <= videoRect.bottom

      if (!isInside) {
        if (this.isHovered) {
          this.isHovered = false
          this.targetX = 0
          this.targetY = 0
          this.startAnimation()
        }
        return
      }

      this.isHovered = true
      const buttonRect = this.buttonElement.getBoundingClientRect()

      const maxTravelX = Math.max(0, (videoRect.width - buttonRect.width) / 2)
      const maxTravelY = Math.max(0, (videoRect.height - buttonRect.height) / 2)

      const centerX = videoRect.left + videoRect.width / 2
      const centerY = videoRect.top + videoRect.height / 2

      const rawDeltaX = e.clientX - centerX
      const rawDeltaY = e.clientY - centerY

      this.targetX = Math.max(-maxTravelX, Math.min(maxTravelX, rawDeltaX))
      this.targetY = Math.max(-maxTravelY, Math.min(maxTravelY, rawDeltaY))

      this.startAnimation()
    }

    onMouseEnter = (e: MouseEvent) => {
      this.onMouseMove(e)
    }

    onMouseLeave = () => {
      this.isHovered = false
      this.targetX = 0
      this.targetY = 0
      this.startAnimation()
    }

    animate = () => {
      const ease = 0.16
      this.currentX += (this.targetX - this.currentX) * ease
      this.currentY += (this.targetY - this.currentY) * ease

      if (this.buttonElement) {
        this.buttonElement.style.transform = `translate3d(${this.currentX.toFixed(2)}px, ${this.currentY.toFixed(2)}px, 0)`
      }

      const deltaX = Math.abs(this.targetX - this.currentX)
      const deltaY = Math.abs(this.targetY - this.currentY)

      if (!this.isHovered && deltaX < 0.05 && deltaY < 0.05) {
        this.currentX = 0
        this.currentY = 0
        if (this.buttonElement) {
          this.buttonElement.style.transform = 'translate3d(0, 0, 0)'
        }
        this.stopAnimation()
        return
      }

      this.rafId = requestAnimationFrame(this.animate)
    }

    startAnimation() {
      if (!this.rafId) {
        this.rafId = requestAnimationFrame(this.animate)
      }
    }

    stopAnimation() {
      if (this.rafId) {
        cancelAnimationFrame(this.rafId)
        this.rafId = null
      }
    }

    bindEvents() {
      const target = this.wrapperElement
      if (!target || !this.buttonElement) return

      if (window.matchMedia('(pointer: fine)').matches) {
        target.addEventListener('mouseenter', this.onMouseEnter)
        target.addEventListener('mousemove', this.onMouseMove)
        target.addEventListener('mouseleave', this.onMouseLeave)
      }
    }
  }

  new FloatingPlayButton()
</script>
